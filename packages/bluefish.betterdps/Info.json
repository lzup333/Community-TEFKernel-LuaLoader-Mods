  "settings": [
    {
      "key": "lock_dummy",
      "title": "召唤物锁定傀儡",
      "description": "开启后，召唤物会把训练用傀儡当作可攻击目标（原版因为傀儡无敌而不会锁定）。",
      "type": "CHOICE",
      "defaultValue": "true",
      "options": [
        {
          "value": "true",
          "label": "开启"
        },
        {
          "value": "false",
          "label": "关闭"
        }
      ],
      "section": "功能设置"
    },
    {
      "key": "count_trap",
      "title": "DPS 计入陷阱伤害",
      "description": "开启后，陷阱弹幕、尖刺等不是由玩家直接造成的伤害也计入 DPS。",
      "type": "CHOICE",
      "defaultValue": "true",
      "options": [
        {
          "value": "true",
          "label": "开启"
        },
        {
          "value": "false",
          "label": "关闭"
        }
      ],
      "section": "功能设置"
    },
    {
      "key": "count_debuff",
      "title": "DPS 计入减益伤害",
      "description": "开启后，中毒、着火、流血等持续伤害（DoT）也计入 DPS。",
      "type": "CHOICE",
      "defaultValue": "true",
      "options": [
        {
          "value": "true",
          "label": "开启"
        },
        {
          "value": "false",
          "label": "关闭"
        }
      ],
      "section": "功能设置"
    }
  ]
